# CallFlow Backend API — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# Supabase PostgreSQL connection string
CALLFLOW_DATABASE_URL=

# Supabase project URL
CALLFLOW_SUPABASE_URL=

# Supabase service-role key (SECRET — backend only)
CALLFLOW_SUPABASE_SERVICE_KEY=

# LLM API key (SECRET — backend only)
CALLFLOW_LLM_API_KEY=

# LLM model identifier (e.g., gemini-2.0-flash, gpt-4o)
CALLFLOW_LLM_MODEL=

# CORS allowed origin (frontend URL)
CALLFLOW_CORS_ORIGIN=

# Server port (Render sets PORT automatically)
PORT=8000
