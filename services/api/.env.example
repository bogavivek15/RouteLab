# RouteLab Backend API — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# Note: ROUTELAB_* is standard; CALLFLOW_* is also supported for backward compatibility.

# Supabase PostgreSQL connection string
ROUTELAB_DATABASE_URL=
# (or CALLFLOW_DATABASE_URL=)

# Supabase project URL
ROUTELAB_SUPABASE_URL=
# (or CALLFLOW_SUPABASE_URL=)

# Supabase service-role key (SECRET — backend only)
ROUTELAB_SUPABASE_SERVICE_KEY=
# (or CALLFLOW_SUPABASE_SERVICE_KEY=)

# LLM API key (Google Gemini — SECRET — backend only)
ROUTELAB_LLM_API_KEY=
# (or CALLFLOW_LLM_API_KEY=)

# LLM model identifier (default: gemini-2.0-flash)
ROUTELAB_LLM_MODEL=gemini-2.0-flash

# CORS allowed origin (frontend URL or * for development)
ROUTELAB_CORS_ORIGIN=*

# Server port (Render sets PORT automatically)
PORT=8000
