# CallFlow Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# Base URL for the CallFlow backend API
VITE_CALLFLOW_API_BASE_URL=

# Supabase project URL (public — safe for frontend)
VITE_CALLFLOW_SUPABASE_URL=

# Supabase anonymous/public key (safe for frontend)
VITE_CALLFLOW_SUPABASE_ANON_KEY=
