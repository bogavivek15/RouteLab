# RouteLab Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# Note: VITE_ROUTELAB_* is standard; VITE_CALLFLOW_* is also supported.

# Base URL for the backend API (/api proxies to local backend in development)
VITE_ROUTELAB_API_BASE_URL=
# (or VITE_CALLFLOW_API_BASE_URL=)

# Supabase project URL (public — safe for frontend)
VITE_ROUTELAB_SUPABASE_URL=
# (or VITE_CALLFLOW_SUPABASE_URL=)

# Supabase anonymous/public key (safe for frontend)
VITE_ROUTELAB_SUPABASE_ANON_KEY=
# (or VITE_CALLFLOW_SUPABASE_ANON_KEY=)
